# Endpoint compativel com a API da OpenAI. Padrao do projeto: Gemini (free tier).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=changeme
LLM_MODEL=gemini-2.0-flash

# Limite de tokens de saida por chamada. Se a resposta for cortada nesse
# limite, o devsquad levanta um erro claro em vez de tentar interpretar JSON
# incompleto. Aumente se tarefas grandes estiverem sendo cortadas; diminua se
# o provedor recusar a requisicao por exceder o limite de tokens por minuto
# (comum em free tiers, ex: Groq free tier = 8000 TPM por requisicao).
LLM_MAX_OUTPUT_TOKENS=4096

# Opcional: modelo diferente por agente. Se vazio, usa LLM_MODEL.
REFINER_MODEL=
CODER_MODEL=
QA_MODEL=
ARCHITECT_MODEL=
INTEGRATION_QA_MODEL=

# Loop de autocorrecao (devsquad run)
MAX_ITERATIONS=3

# Tentativas de correcao de integracao (devsquad build-feature)
MAX_INTEGRATION_ITERATIONS=2

# Timeout (segundos) para executar os testes gerados
TEST_TIMEOUT_SECONDS=30
